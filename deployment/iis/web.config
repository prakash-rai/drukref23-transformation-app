<?xml version="1.0" encoding="UTF-8"?>
<!--
  IIS application "drukref" under the site that hosts https://cadastral.systems.gov.bt
  (physical path: an empty folder such as C:\inetpub\drukref containing only this file).
  Requires the IIS URL Rewrite and Application Request Routing (ARR) modules, with the ARR proxy enabled.
  Forwards /drukref/* to the DrukRef Windows service on 127.0.0.1:8080, keeping the /drukref prefix.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- /drukref  ->  /drukref/  (handled here so the app never builds an internal redirect URL) -->
        <rule name="DrukRef trailing slash" stopProcessing="true">
          <match url="^$" />
          <conditions>
            <add input="{REQUEST_URI}" pattern="^/drukref$" ignoreCase="true" />
          </conditions>
          <action type="Redirect" url="/drukref/" redirectType="Permanent" />
        </rule>
        <rule name="DrukRef reverse proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/drukref/{R:1}" appendQueryString="true" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- Allow upload packages up to ~4 GB (IIS maximum); the app enforces MAX_UPLOAD_MB. -->
        <requestLimits maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
