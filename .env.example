# Copy to .env and fill in. .env is ignored by git. In production it lives at C:\apps\drukref\.env.
# Every variable is documented in docs/configuration.md. Quote values containing $ or # with single quotes.

# --- ArcGIS Server (token-secured, standalone) ---
# Web adaptor root the app server calls. The container on the IIS host can use the public name
# (see docs/deployment.md, Troubleshooting, if the server cannot reach its own public name).
ARCGIS_SERVER_URL=https://cadastral.systems.gov.bt/server
# Dedicated ArcGIS Server user with access only to the project GP service.
ARCGIS_USERNAME=
ARCGIS_PASSWORD=
# GP service path below /rest/services, and the task name inside it.
ARCGIS_GP_SERVICE=project/ProjectUploadPackage
ARCGIS_GP_TASK=ProjectUploadPackage
# Tokens are bound to this referer; the app sends it on every ArcGIS request.
ARCGIS_TOKEN_REFERER=https://cadastral.systems.gov.bt/drukref/
# Token lifetime in minutes (refreshed automatically 5 minutes before expiry).
ARCGIS_TOKEN_MINUTES=60

# --- App ---
# Largest package the app accepts (MB). Keep at or below the IIS and ArcGIS upload limits.
MAX_UPLOAD_MB=2048
# Public sub-path IIS publishes the app under. Build-time: production builds take it from the GitHub variable of the same name.
APP_BASE_PATH=/drukref/
# Port the app listens on, on 127.0.0.1 only; IIS proxies to it.
APP_PORT=8080
